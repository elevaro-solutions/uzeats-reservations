{
  "name": "reservations",
  "version": "0.88.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev --parallel --filter='!@reservations/mobile' --filter='!@reservations/merchant-mobile'",
    "dev:mobile": "pnpm --filter @reservations/mobile dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "pnpm --filter @reservations/shared test",
    "test:integration": "pnpm --filter @reservations/api test",
    "test:e2e": "pnpm --filter @reservations/e2e test:e2e",
    "test:e2e:smoke": "pnpm --filter @reservations/e2e test:e2e:smoke",
    "db:up": "docker compose up -d --build",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --build && sleep 8 && pnpm seed",
    "seed": "pnpm --filter @reservations/api seed",
    "codegen": "pnpm --filter @reservations/api codegen && pnpm --filter @reservations/shared codegen"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  }
}
